{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-run.schema.json",
  "title": "Governed memory-operation run artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "started_at",
    "completed_at",
    "dry_run",
    "status",
    "inputs",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{16,64}$"
    },
    "run_type": {
      "enum": [
        "legacy_migration",
        "candidate_ingest",
        "promotion",
        "rollback",
        "lint",
        "stats"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "planned"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
