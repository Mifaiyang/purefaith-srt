{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termbase.schema.json",
  "title": "PUREFAITH governed bilingual termbase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "termbase_id",
    "version",
    "status",
    "brand",
    "source_locale",
    "target_locale",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "termbase_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "brand": {
      "type": "string"
    },
    "source_locale": {
      "const": "zh-CN"
    },
    "target_locale": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term_id",
          "source",
          "target",
          "part_of_speech",
          "domain",
          "status",
          "evidence",
          "approval"
        ],
        "properties": {
          "term_id": {
            "type": "string",
            "pattern": "^term-[A-Za-z0-9._-]+$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical",
              "aliases"
            ],
            "properties": {
              "canonical": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preferred",
              "allowed",
              "forbidden"
            ],
            "properties": {
              "preferred": {
                "type": "string",
                "minLength": 1
              },
              "allowed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "forbidden": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "part_of_speech": {
            "type": "string"
          },
          "domain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "candidate",
              "confirmed",
              "deprecated"
            ]
          },
          "case_sensitive": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "approval": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
