{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-record.schema.json",
  "title": "PUREFAITH governed translation-memory record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "status",
    "source",
    "target",
    "classification",
    "provenance",
    "approval",
    "quality",
    "policy_versions",
    "lifecycle",
    "retrieval"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "status": {
      "enum": [
        "candidate",
        "legacy_unverified",
        "approved",
        "deprecated",
        "quarantined"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "language",
        "text",
        "normalized_text",
        "span"
      ],
      "properties": {
        "language": {
          "const": "zh-CN"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "normalized_text": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "complete_thought",
                "cue_fragment",
                "legacy_unknown"
              ]
            },
            "document_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "sentence_group_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "cue_indexes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            }
          }
        },
        "context_before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before_record_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "after_record_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "language",
        "locale",
        "canonical_text",
        "rendered_cues"
      ],
      "properties": {
        "language": {
          "const": "en"
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "canonical_text": {
          "type": "string",
          "minLength": 1
        },
        "rendered_cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "cue_index": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "legacy_unverified",
            "approved",
            "rejected",
            "revoked"
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "flags"
      ],
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "created_at"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "eligible",
        "reasons"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
