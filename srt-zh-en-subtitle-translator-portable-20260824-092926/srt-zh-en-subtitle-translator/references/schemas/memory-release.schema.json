{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-release.schema.json",
  "title": "Immutable PUREFAITH translation-memory release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "source",
    "record_count",
    "records_sha256",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "release_id": {
      "type": "string",
      "pattern": "^rel-[a-f0-9]{16,64}$"
    },
    "created_at": {
      "type": "string"
    },
    "parent_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": true
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "memory-record.schema.json"
      }
    }
  }
}
